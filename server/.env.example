PORT=5000
# Required when NODE_ENV=production (server refuses to start without it)
JWT_SECRET=replace_with_a_long_random_secret
# Local MongoDB (must be a replica set for payment transactions) or a MongoDB Atlas URI
MONGO_URI=mongodb://localhost:27017/lms
# Frontend origin, e.g. https://<your-app>.vercel.app in production
CLIENT_URL=http://localhost:3000
# Set to "production" on Render (enables secure cookies)
NODE_ENV=development
